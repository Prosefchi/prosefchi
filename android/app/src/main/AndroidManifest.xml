<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Scheduled alarms do not survive a restart. Without this and the
         receiver below, every reminder silently disappears the first time the
         phone reboots, which for a reminder app is the whole product failing
         quietly.

         POST_NOTIFICATIONS and VIBRATE are not declared here: the
         flutter_local_notifications manifest already contributes them at merge
         time. SCHEDULE_EXACT_ALARM is deliberately absent, since reminders are
         scheduled inexactly to avoid a permission the user must grant by hand
         and which Play policy restricts to alarm and calendar apps. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Posts a scheduled reminder when its alarm fires. Nothing works
             without this line, and nothing complains about its absence either.

             Every alarm the plugin sets targets this receiver explicitly. An
             undeclared receiver is not a component the system can deliver to, so
             the broadcast is dropped: the notification is never shown, the chain
             that arms the following day never advances, and — because the plugin
             creates a notification channel only when it first posts to it — the
             app's notification settings stay empty, which reads as "this app has
             no notifications" rather than as a manifest fault. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- Reschedules pending reminders after a reboot or an app update.
             MY_PACKAGE_REPLACED matters as much as BOOT_COMPLETED: updating
             through the store also clears scheduled alarms. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- A source link in a prayer opens in a Custom Tab, which means
             resolving which installed app can show an https page. From Android
             11 an app cannot see another it has not declared an interest in, so
             without this the resolution finds nothing: the link does not open,
             and the failure looks like a device with no browser rather than a
             manifest that never asked. url_launcher contributes its
             WebViewActivity at merge time but no queries entry, so this is the
             app's to declare. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
