<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Overrides the launcher name from main/ for debug builds only: the
         debug source set wins over main during resource merging. Without it a
         debug build installed beside the release is two identical icons with
         identical names, and the only way to tell them apart is App info.

         Every locale in main/ needs its own override here, since a qualified
         values-el in main/ beats an unqualified values in debug/. -->
    <string name="app_name">Orthodox Prayer (debug)</string>
</resources>
