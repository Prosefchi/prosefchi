# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing material — never commit release keys
*.jks
*.keystore
**/android/key.properties
**/android/local.properties

# Calendar data is generated by tool/build_calendar.dart and published to
# GitHub Pages, never committed. It lands under /build/ locally and the
# downloaded ICS cache under /.dart_tool/, both already ignored above.
#
# The website is generated by tool/build_site.dart into the same directory and
# is not committed either. /public/ is what CI passes as --out; a local run
# defaults to /build/site.
/public/

# Regenerated from lib/l10n/*.arb on every `flutter pub get`. The .arb files
# are the source; these are not.
/lib/l10n/app_localizations*.dart
